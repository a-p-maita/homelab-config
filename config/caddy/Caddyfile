# Caddy reverse proxy — Cloudflare Tunnel HTTP backend
#
# Architecture: Cloudflare (TLS edge) → cloudflared → Caddy (plain HTTP) → services
# TLS is terminated at Cloudflare's edge. The cloudflared → Caddy hop is HTTP on the
# internal Docker network (homelab_net), which is not exposed to the internet.
# This removes the Origin Certificate dependency and SNI matching issues entirely.
#
# Cloudflare Tunnel dashboard: set all public hostname service URLs to http://caddy:80
#
# Authelia forward_auth:
#   auth.andreasmaita.com  → no forward_auth (it IS the auth portal)
#   seerr                  → forward_auth (one_factor per Authelia access_control rules)
#   abs, music, immich, vault, yamtrack → forward_auth (two_factor, default policy)
#   jellyfin, git, join, joplin, feishin, octo-fiesta, actual-budget → no forward_auth (own auth)

{
    # No TLS managed by Caddy — cloudflared handles it at the edge.
    auto_https off
    # Trust X-Forwarded-Proto: https sent by cloudflared (private Docker network IP).
    # Without this Caddy overwrites it with 'http' (its own connection scheme),
    # breaking Authelia TOTP generation and forward_auth scheme checks.
    servers {
        trusted_proxies static private_ranges
    }
}

# Reusable snippet: Authelia forward_auth (Authelia v4.38+ URI)
(authelia_auth) {
    forward_auth authelia:9091 {
        uri /api/authz/forward-auth
        copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
    }
}

# ─── Auth portal ─────────────────────────────────────────────────────────────
http://auth.andreasmaita.com {
    reverse_proxy authelia:9091
}

# ─── Media ───────────────────────────────────────────────────────────────────
# No forward_auth — Jellyfin has its own multi-user auth system.
# Authelia only has one account (andreas); other Jellyfin users would be locked out.
http://jellyfin.andreasmaita.com {
    reverse_proxy jellyfin:8096
}

http://seerr.andreasmaita.com {
    import authelia_auth
    reverse_proxy seerr:5055
}

http://abs.andreasmaita.com {
    import authelia_auth
    reverse_proxy audiobookshelf:80
}

http://music.andreasmaita.com {
    import authelia_auth
    reverse_proxy navidrome:4533
}

# ─── Cloud ───────────────────────────────────────────────────────────────────
http://immich.andreasmaita.com {
    import authelia_auth
    reverse_proxy immich-server:2283
}

# ─── Services ────────────────────────────────────────────────────────────────
http://vault.andreasmaita.com {
    import authelia_auth
    reverse_proxy vaultwarden:80
}

# No forward_auth — Forgejo has its own authentication.
# Git HTTP (push/pull/clone) uses HTTP Basic Auth with tokens, which is
# incompatible with Authelia's cookie-based sessions.
http://git.andreasmaita.com {
    reverse_proxy forgejo:3000
}

# No forward_auth — Wizarr serves public invite links to users who don't
# have Authelia accounts yet; Wizarr manages its own auth for the admin UI.
http://join.andreasmaita.com {
    reverse_proxy wizarr:5690
}

# No forward_auth — Joplin uses token-based API auth for client sync.
# Cookie-based Authelia sessions would break Joplin desktop/mobile client connections.
http://joplin.andreasmaita.com {
    reverse_proxy joplin:22300
}

# ─── Media tracking ──────────────────────────────────────────────────────────
# Yamtrack — media tracker (movies/TV/games/manga)
http://yamtrack.andreasmaita.com {
    import authelia_auth
    reverse_proxy yamtrack:8000
}

# Feishin — web music player (Subsonic-compatible frontend)
# No forward_auth — SERVER_LOCK=true in compose; auth handled by the backend (octo-fiesta)
http://feishin.andreasmaita.com {
    reverse_proxy feishin:9180
}

# Octo-Fiesta — Subsonic API proxy / hi-res music provider
# No forward_auth — Feishin authenticates to this service directly using Subsonic credentials
http://octo-fiesta.andreasmaita.com {
    reverse_proxy octo-fiesta:8080
}

# ─── Finance ─────────────────────────────────────────────────────────────────
# Actual Budget — local-first budget app
# Requires COOP + COEP headers for SharedArrayBuffer (WASM) to work in browser.
# No forward_auth — Actual Budget manages its own password auth.
http://actual-budget.andreasmaita.com {
    header {
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Embedder-Policy "require-corp"
    }
    reverse_proxy actual-budget:5006
}

# ─── Monitoring ──────────────────────────────────────────────────────────────
# Accept both home.andreasmaita.com and homepage.andreasmaita.com (tunnel may use either)
http://home.andreasmaita.com, http://homepage.andreasmaita.com {
    import authelia_auth
    reverse_proxy homepage:3000
}
