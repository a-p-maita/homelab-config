# Ignore all persistent and sensitive data
data/
*.env*
.DS_Store
*.log
backups/
*.rendered

# Except the .env example for the layout
!.env.example

# TLS certificates and private keys
*.pem
*.crt
*.key

# TLS/le-tencrypt and cert directories
letsencrypt/
certs/

# Java heap dumps (Stirling-PDF OOM artifacts)
*.hprof

# Editor artifacts
*.swp
*~

# Python cache
__pycache__/
*.pyc
*.pyo


*
*/

!.gitignore
!README.md
!.env.example
data/
scripts/
!stacks/
!stacks/*
!secrets-example
!secrets-example/*
