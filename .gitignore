# Ignore all persistent and sensitive data
homelab-data/
data/
.env
.DS_Store
*.log
# Ignore cloudflared credentials if generated locally
core/cloudflared/
backups/

# Caddy runtime config (auto-generated, root-owned — causes Permission denied in git)
config/caddy/caddy/

# TLS certificates and private keys (sensitive — never commit)
*.pem
*.crt
*.key

# Authelia auto-generated runtime files
config/authelia/db.sqlite3
config/authelia/notification.txt
config/authelia/users_database.yml

# Java heap dumps (Stirling-PDF OOM artifacts)
*.hprof

# Editor artifacts
*.swp
*~

# Python cache
__pycache__/
*.pyc
*.pyo

# Rendered secret outputs (never commit)
.env.rendered
*.rendered

# Local override and generated files
docker-compose.override.yml
.env.local

# TLS/le-tencrypt and cert directories
letsencrypt/
certs/
