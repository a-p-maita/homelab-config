# Ignore default stuff
*
!.gitignore
!README.md

# Ignore MacOS annoyance
.DS_Store

# Ignore persistent/perm data obviously too large to store, plus doesn't follow IaC idea of whole homelab
data/

# Don't ignore compose stacks themselves
!stacks/
!stacks/*

# Env files ignore, and allow example template
.env
!.env.example

# Secrets ignore, and allow example template
secrets/
secrets/*
!secrets-example
!secrets-example/*

# Not the scripts
!scripts/
!scripts/*.sh
