# Ignore all persistent and sensitive data
data/
.DS_Store
*.log
backups/
*.rendered

# Secrets — actual secret files must never be committed
secrets/
*.secret
acme/
acme.json

# Env files — all .env files are gitignored except .env.example
.env
**/.env
# Allow example files
!.env.example
!**/.env.example

# TLS certificates and private keys
*.pem
*.crt
*.key

# TLS/letsencrypt and cert directories
letsencrypt/
certs/

# Java heap dumps (Stirling-PDF OOM artifacts)
*.hprof

# Editor artifacts
*.swp
*~

# Python cache
__pycache__/
*.pyc
*.pyo


*
*/

!.gitignore
!README.md
!.env.example
data/
scripts/
!stacks/
!stacks/*
!secrets-example
!secrets-example/*
!Makefile
