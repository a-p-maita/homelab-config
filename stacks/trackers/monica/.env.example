# service-specific environment variables put in here for "simplicity" kinda moreso just less duplication
# Gen key with `echo -n 'base64:'; openssl rand -base64 32``
MONICA_APP_KEY=base64:changeme-long-string-here=
MONICA_DB_PASSWORD=base64:changeme-long-string-here=
MONICA_MYSQL_USER=changeme-or-don't-monica-user
