# Global config — NO secrets here.
# Secrets belong in per-service secrets/ files (see each service's secrets-example/ dir).
# Copy this file to .env and fill in your values.

# ── Paths ──────────────────────────────────────────────────────────────────
DATA_ROOT=/path/to/homelab-config/data

# ── User/Group ─────────────────────────────────────────────────────────────
PUID=1000
PGID=1000

# ── Timezone ───────────────────────────────────────────────────────────────
# TZ is the standard var used by most container images
TZ=Europe/London

# ── Domain ─────────────────────────────────────────────────────────────────
DOMAIN=changeme.example.com
EXTERNAL_URL=https://changeme.example.com

# ── Auth defaults ──────────────────────────────────────────────────────────
DEFAULT_ADMIN=admin
ALLOW_SIGNUP=false
ALLOW_SIGNUP_STRING=false

# ── Ports — Infrastructure = 20xxx ─────────────────────────────────────────
TRAEFIK_PORT=20000
TRAEFIK_DASHBOARD_PORT=20001

# ── Ports — Maintenance = 21xxx ────────────────────────────────────────────
UPTIMEKUMA_PORT=21000

# ── Ports — Media = 22xxx ──────────────────────────────────────────────────
AUDIOBOOKSHELF_PORT=22000
JELLYFIN_PORT=22001
NAVIDROME_PORT=22002

# ── Ports — Cloud = 23xxx ──────────────────────────────────────────────────
VAULTWARDEN_PORT=23000
IMMICH_PORT=23001
FORGEJO_HTTP_PORT=23002
FORGEJO_SSH_PORT=23003
PAPERLESS_PORT=23004
NEXTCLOUD_PORT=23005

# ── Ports — Trackers = 24xxx ───────────────────────────────────────────────
ACTUAL_BUDGET_PORT=24000
MEALIE_PORT=24001
YAMTRACK_PORT=24002

# ── Ports — *arr = 25xxx ───────────────────────────────────────────────────
QBITTORRENT_WEBUI_PORT=25000
PROWLARR_PORT=25001
RADARR_PORT=25002
SONARR_PORT=25003
