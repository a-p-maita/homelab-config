# Root .env.example for all stacks
# Copy to .env and fill in your values. .env is gitignored; this file is tracked.

# ─── Core ────────────────────────────────────────────────────────────────────TZ=Europe/LondonCLOUDFLARED_PORT=20280
TUNNEL_TOKEN=put_your_cloudflare_tunnel_token_here

# ─── Media stack ─────────────────────────────────────────────────────────────
PUID=1000
PGID=1000
ABS_PORT=20020

# ─── Yamtrack (media tracker) ─────────────────────────────────────────────────
YAMTRACK_PORT=20041
CROSSWATCH_PORT=20042
# generate SECRET: python3 -c "import secrets; print(secrets.token_hex(32))"
YAMTRACK_SECRET=your_yamtrack_secret_key
YAMTRACK_EXTERNAL_URL=https://yamtrack.your-domain.com
YAMTRACK_REGISTRATION=False
# TMDB v3 API key (optional — Yamtrack has a built-in default)
# Get from: https://www.themoviedb.org/settings/api → API Key (v3 auth)
YAMTRACK_TMDB_API=
# Trakt OAuth — register app at https://trakt.tv/oauth/applications
# Redirect URI to register: https://yamtrack.your-domain.com/import/trakt/private
YAMTRACK_TRAKT_CLIENT_ID=your_trakt_client_id
YAMTRACK_TRAKT_CLIENT_SECRET=your_trakt_client_secret
# AniList OAuth — register app at https://anilist.co/settings/developer
# Redirect URI to register: https://yamtrack.your-domain.com/import/anilist/private
YAMTRACK_ANILIST_CLIENT_ID=your_anilist_client_id
YAMTRACK_ANILIST_CLIENT_SECRET=your_anilist_client_secret

# ─── Arr stack (ports 20050–20059: all download-automation services) ──────────
QBITTORRENT_WEBUI_PORT=20050
QBITTORRENT_TCP_PORT=20051
QBITTORRENT_UDP_PORT=20052
QBITTORRENT_WEBUI_USER=your_qbt_username
QBITTORRENT_WEBUI_PASS=your_qbt_webui_password
ABB_PORT=20053
JACKETT_PORT=20054
JACKETT_API_KEY=your_jackett_api_key
PROWLARR_PORT=20055
RADARR_PORT=20056
SONARR_PORT=20057
LAZYLIBRARIAN_PORT=20058
LIDARR_PORT=20059
BYPARR_PORT=20060
# ── Homepage widget API keys — fill in after first arr stack start ────────────
# Find each key: Settings → General inside the respective service web UI.
# Then restart the monitoring stack: docker compose -f dockerfiles/monitoring/compose.yaml up -d
RADARR_API_KEY=
SONARR_API_KEY=
LIDARR_API_KEY=
LAZYLIBRARIAN_API_KEY=
PROWLARR_API_KEY=

# New services
WIZARR_PORT=20071
CLEANUPARR_PORT=20062
LISTENARR_PORT=20073
AUTOBRR_PORT=20074
PROFILARR_PORT=20075
YOUTARR_PORT=20080
YOUTARR_DB_PASSWORD=
YOUTUBE_OUTPUT_DIR=
KOMGA_PORT=20077
CALIBREWEB_PORT=20078
BOOKBOUNTY_PORT=20079
MAINTAINERR_PORT=6246
AUTHELIA_PORT=9091
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
SCRUTINY_PORT=8081

# ─── Gluetun / ProtonVPN (optional — set USE_VPN=true to activate) ────────────
USE_VPN=false
# Generate at: account.proton.me/u/0/vpn/WireGuard → Linux → WireGuard → Create
# Paste the PrivateKey= value from the downloaded .conf file here
PROTONVPN_WIREGUARD_PRIVATE_KEY=
# Comma-separated P2P-capable countries: Netherlands, Switzerland, Iceland, Sweden
PROTONVPN_SERVER_COUNTRIES=Netherlands
# Time allowed for VPN tunnel to connect before healthchecks start
HEALTH_VPN_DURATION_INITIAL=120s

# ─── Music ────────────────────────────────────────────────────────────────────
NAVIDROME_PORT=20070
FEISHIN_PORT=20072
# Public tunnel URL for Navidrome — Feishin browser client connects here
NAVIDROME_EXTERNAL_URL=https://navidrome.your-domain.com
# Octo-Fiesta (Subsonic API proxy — intercepts playback to stream hi-res from providers)
OCTOFIESTA_PORT=20076
OCTOFIESTA_EXTERNAL_URL=https://octo-fiesta.your-domain.com
# Provider: SquidWTF (free, no creds), Deezer, Qobuz, or Yandex
OCTOFIESTA_MUSIC_SERVICE=SquidWTF
# SquidWTF settings (Qobuz or Tidal backend, no account required)
OCTOFIESTA_SQUIDWTF_SOURCE=Qobuz
OCTOFIESTA_SQUIDWTF_QUALITY=
# Deezer settings (leave blank if not using Deezer)
OCTOFIESTA_DEEZER_ARL=
OCTOFIESTA_DEEZER_ARL_FALLBACK=
OCTOFIESTA_DEEZER_QUALITY=
# Qobuz settings (leave blank if not using Qobuz)
OCTOFIESTA_QOBUZ_USER_AUTH_TOKEN=
OCTOFIESTA_QOBUZ_USER_ID=
OCTOFIESTA_QOBUZ_QUALITY=
# Yandex Music settings (leave blank if not using Yandex)
OCTOFIESTA_YANDEX_OAUTH_TOKEN=
OCTOFIESTA_YANDEX_QUALITY=

# ─── Productivity ─────────────────────────────────────────────────────────────
FORGEJO_WEB_PORT=20110
FORGEJO_SSH_PORT=20111
FORGEJO__server__ROOT_URL=https://forgejo.your-domain.com
FORGEJO__server__HTTP_ADDR=0.0.0.0
FORGEJO__server__HTTP_PORT=3000
FORGEJO__server__SSH_DOMAIN=forgejo.your-domain.com
FORGEJO__server__OFFLINE_MODE=false

# ─── Monitoring ───────────────────────────────────────────────────────────────
HOMEPAGE_PORT=20200
UPTIMEKUMA_PORT=20201
UPTIMEKUMA_USER=your_uptimekuma_username
UPTIMEKUMA_PASS=your_uptimekuma_password
# Comma-separated host:port pairs allowed to access Homepage (prevents host validation errors)
HOMEPAGE_ALLOWED_HOSTS=your-tailscale-ip:20200,localhost:20200,localhost:3000,homepage.your-domain.com

# ─── Immich ───────────────────────────────────────────────────────────────────
# Absolute paths — edit to match your server
UPLOAD_LOCATION=/home/yourusername/homelab-config/data/immich_upload
DB_DATA_LOCATION=/home/yourusername/homelab-config/data/immich_db
# Pin to current stable — check https://github.com/immich-app/immich/releases
# Do NOT use 'release' tag — Immich DB migrations run on every version bump
IMMICH_VERSION=v2.7.5
DB_PASSWORD=your_immich_db_password
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# ─── Documents stack (paperless-ngx, stirling-pdf, kiwix) ────────────────────
PAPERLESS_PORT=20301
STIRLING_PDF_PORT=20303
STIRLING_PDF_USERNAME=admin
STIRLING_PDF_PASSWORD=your_stirling_pdf_password
KIWIX_PORT=20304

PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_EMAIL=admin@example.com
PAPERLESS_ADMIN_PASS=your_paperless_admin_password
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASS=your_paperless_db_password
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
PAPERLESS_SECRET_KEY=your_64char_random_secret_key
PAPERLESS_EXTERNAL_URL=https://paperless.your-domain.com

# ─── Tools stack (draw.io, excalidraw, IT-Tools, vaultwarden, actual-budget, joplin) ──
DRAWIO_PORT=20311
EXCALIDRAW_PORT=20312
IT_TOOLS_PORT=20313
VAULTWARDEN_PORT=20315
ACTUAL_BUDGET_PORT=20316
JOPLIN_PORT=20317
JOPLIN_MAILER_ENABLED=1

# Generate admin token hash: docker run --rm -it vaultwarden/server /vaultwarden hash --preset owasp
VAULTWARDEN_ADMIN_TOKEN=your_argon2_hashed_admin_password
VAULTWARDEN_EXTERNAL_URL=https://vault.your-domain.com
JOPLIN_EXTERNAL_URL=https://joplin.your-domain.com
JOPLIN_DB_USER=joplin
JOPLIN_DB_PASS=your_joplin_db_password
# Joplin SMTP (set JOPLIN_MAILER_ENABLED=1 and fill in host/user/pass to enable email)
JOPLIN_MAILER_ENABLED=0
JOPLIN_MAILER_HOST=smtp.example.com
JOPLIN_MAILER_PORT=587
JOPLIN_MAILER_SECURITY=starttls
JOPLIN_MAILER_USER=your_smtp_username
JOPLIN_MAILER_PASS=your_smtp_password
JOPLIN_MAILER_FROM=noreply@your-domain.com

# ─── Personal stack (mealie) ──────────────────────────────────────────────────
MEALIE_PORT=20321
MEALIE_EXTERNAL_URL=https://mealie.your-domain.com
# Mealie default admin: changeme@example.com / MyPassword — change on first login

# ─── Entertainment stack (jellyfin, seerr) ──────────────────────────────────
JELLYFIN_PORT=20330
# Seerr — media request manager (Overseerr/Jellyseerr successor)
SEERR_PORT=20331

# ─── New services ─────────────────────────────────────────────────────────────
WIZARR_PORT=20071
CLEANUPARR_PORT=20062
LISTENARR_PORT=20073
AUTOBRR_PORT=20074
PROFILARR_PORT=20075
YOUTARR_PORT=20080
KOMGA_PORT=20077
CALIBREWEB_PORT=20078
BOOKBOUNTY_PORT=20079
MAINTAINERR_PORT=6246
AUTHELIA_PORT=9091
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
SCRUTINY_PORT=8081
# IGDB API: register app at https://dev.twitch.tv → Applications → New App
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret

# ─── Home stack (home-assistant) ──────────────────────────────────────────────
HOME_ASSISTANT_PORT=20340

# ─── Data root (absolute path — change this line when migrating to a new server) ──
DATA_ROOT=/home/yourusername/homelab-config/data
# ─── Auto-generated secrets (run scripts/generate-secrets.sh) ──────────────
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_KEY=
GRAFANA_PASSWORD=
RESTC_BACKUP_PASSWORD=
RESTC_S3_KEY_ID=
RESTC_S3_SECRET=

# ─── Cloudflare ────────────────────────────────────────────────────────────
CF_API_TOKEN=
