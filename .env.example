# Root .env.example for all stacks
# Copy to .env and fill in your values. .env is gitignored; this file is tracked.
#
# After copying, run: ./scripts/generate-secrets.sh
# That script auto-generates all random secrets (Authelia, DB passwords, etc.)
# You only need to fill in the values that require registration or manual choices.

# ─── Core ────────────────────────────────────────────────────────────────────
TZ=Europe/London
PUID=1000
PGID=1000

# ─── Paths ────────────────────────────────────────────────────────────────────
# DATA_ROOT: absolute path to media storage (movies, music, torrents, photos)
# Must NOT be inside the repo directory — backed up separately by backup.sh
DATA_ROOT=/home/a-p-maita/homelab-data

# UPLOAD_LOCATION: Immich photo/video library — required by the upstream compose.yaml
# Docker Compose resolves ${DATA_ROOT} correctly so this reference works:
UPLOAD_LOCATION=${DATA_ROOT}/photos

# ─── Cloudflare ───────────────────────────────────────────────────────────────
# Token from: dash.cloudflare.com → Zero Trust → Access → Tunnels → your tunnel → Configure → Token
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
CLOUDFLARED_PORT=20280

# ─── VPN (optional — set USE_VPN=true to apply compose.vpn.yaml overlay) ──────
USE_VPN=false
# ProtonVPN credentials: account.proton.me → VPN → Downloads → OpenVPN/IKEv2 config
# These are NOT your ProtonVPN login — they are a separate generated VPN key pair
OPENVPN_USER=your_protonvpn_openvpn_username
OPENVPN_PASSWORD=your_protonvpn_openvpn_password
PROTONVPN_SERVER_COUNTRIES=Netherlands      # P2P-capable country
HEALTH_VPN_DURATION_INITIAL=120s

# ─── Authelia (auto-generated by generate-secrets.sh) ────────────────────────
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# ─── qBittorrent ─────────────────────────────────────────────────────────────
QBITTORRENT_WEBUI_PORT=20050
QBITTORRENT_TCP_PORT=20051
QBITTORRENT_UDP_PORT=20052
QBITTORRENT_WEBUI_USER=a-p-maita
QBITTORRENT_WEBUI_PASS=your_qbt_webui_password

# ─── Immich ───────────────────────────────────────────────────────────────────
# ⚠ Pin to the exact version you install — never change during a migration.
# Check releases: https://github.com/immich-app/immich/releases
IMMICH_VERSION=release
# DB_PASSWORD consumed directly by the upstream Immich compose.yaml (auto-generated)
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# ─── Nextcloud ────────────────────────────────────────────────────────────────
# ⚠ All vars below must be set BEFORE the first container start.
# Changing them post-init requires manual `occ config:system:set` commands.
NEXTCLOUD_ADMIN_USER=a-p-maita
NEXTCLOUD_ADMIN_PASSWORD=your_nextcloud_admin_password
NEXTCLOUD_DB_PASSWORD=                      # auto-generated
NEXTCLOUD_REDIS_PASSWORD=                   # auto-generated
NEXTCLOUD_TRUSTED_DOMAINS=nextcloud.andreasmaita.com 100.106.40.5
OVERWRITEPROTOCOL=https
OVERWRITEHOST=nextcloud.andreasmaita.com
OVERWRITECLIURL=https://nextcloud.andreasmaita.com

# ─── Forgejo ──────────────────────────────────────────────────────────────────
# Double-underscore env vars map to app.ini sections: FORGEJO__<Section>__<Key>
FORGEJO__server__ROOT_URL=https://forgejo/
FORGEJO__server__SSH_DOMAIN=forgejo
FORGEJO__server__DOMAIN=forgejo
FORGEJO__server__HTTP_PORT=3000
FORGEJO__server__OFFLINE_MODE=false

# ─── Vaultwarden ──────────────────────────────────────────────────────────────
VAULTWARDEN_SIGNUPS_ALLOWED=false
# Admin panel token: must be Argon2 hash — NOT the plain password.
# Generate: docker run --rm -it vaultwarden/server /vaultwarden hash --preset owasp
# Leave blank to disable the admin panel entirely (recommended for solo use).
VAULTWARDEN_ADMIN_TOKEN=

# ─── Paperless-ngx ────────────────────────────────────────────────────────────
PAPERLESS_SECRET_KEY=                       # auto-generated
PAPERLESS_ADMIN_USER=a-p-maita
PAPERLESS_ADMIN_MAIL=admin@andreasmaita.com
PAPERLESS_ADMIN_PASSWORD=your_paperless_admin_password
PAPERLESS_DB_PASSWORD=                      # auto-generated
PAPERLESS_URL=https://paperless.andreasmaita.com

# ─── Joplin ───────────────────────────────────────────────────────────────────
JOPLIN_DB_PASSWORD=                         # auto-generated
JOPLIN_BASE_URL=https://joplin.andreasmaita.com

# ─── Mealie ───────────────────────────────────────────────────────────────────
MEALIE_DEFAULT_EMAIL=admin@andreasmaita.com
MEALIE_DEFAULT_PASSWORD=your_mealie_admin_password
MEALIE_BASE_URL=https://mealie.andreasmaita.com

# ─── Monica ───────────────────────────────────────────────────────────────────
# ⚠ Must have the base64: prefix — auto-generated by generate-secrets.sh
# Manual generation: echo "base64:$(openssl rand -base64 32)"
MONICA_APP_KEY=

# ─── Yamtrack ─────────────────────────────────────────────────────────────────
YAMTRACK_SECRET=                            # auto-generated
YAMTRACK_EXTERNAL_URL=https://yamtrack.andreasmaita.com
YAMTRACK_REGISTRATION=False
# TMDB v3 API key (optional) — https://www.themoviedb.org/settings/api → API Key (v3 auth)
YAMTRACK_TMDB_API=
# Trakt OAuth — register at https://trakt.tv/oauth/applications
# Redirect URI: https://yamtrack.andreasmaita.com/import/trakt/private
YAMTRACK_TRAKT_CLIENT_ID=
YAMTRACK_TRAKT_CLIENT_SECRET=
# AniList OAuth — register at https://anilist.co/settings/developer
# Redirect URI: https://yamtrack.andreasmaita.com/import/anilist/private
YAMTRACK_ANILIST_CLIENT_ID=
YAMTRACK_ANILIST_CLIENT_SECRET=
# Simkl OAuth — register at https://simkl.com/settings/developer
# Redirect URI: https://yamtrack.andreasmaita.com/import/simkl/private
YAMTRACK_SIMKL_CLIENT_ID=
YAMTRACK_SIMKL_CLIENT_SECRET=
# Steam API key (optional) — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# ─── Backups ──────────────────────────────────────────────────────────────────
RESTIC_BACKUP_PASSWORD=                     # auto-generated
RESTIC_S3_KEY_ID=your_backblaze_b2_key_id
RESTIC_S3_SECRET=your_backblaze_b2_application_key

# ─── Uptime Kuma ──────────────────────────────────────────────────────────────
# Set AFTER running Uptime Kuma for the first time (the UI wizard creates the account).
# Re-run setup-uptime-kuma.sh once these are populated.
UPTIMEKUMA_USER=a-p-maita
UPTIMEKUMA_PASS=

# ─── API keys (fill in after each service starts) ─────────────────────────────
# Found in each service's web UI: Settings → General (or Dashboard → API Keys for Jellyfin)
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
LIDARR_API_KEY=
BAZARR_API_KEY=
JELLYFIN_API_KEY=
SEERR_API_KEY=
ABS_API_KEY=

# ─── Port allocations ─────────────────────────────────────────────────────────

# Infrastructure / Monitoring
HOMEPAGE_PORT=20200
UPTIME_KUMA_PORT=20201
DOCKGE_PORT=20202
SCRUTINY_PORT=20210
BACKREST_PORT=20211

# Media
ABS_PORT=20020
YAMTRACK_PORT=20041
CROSSWATCH_PORT=20042

# Downloads
PROWLARR_PORT=20055
AUTOBRR_PORT=20074

# Arr
RADARR_PORT=20056
SONARR_PORT=20057
LIDARR_PORT=20058
BAZARR_PORT=20059
SHELFMARK_PORT=20079
MAINTAINERR_PORT=20400

# Media servers
JELLYFIN_PORT=20330
SEERR_PORT=20331
NAVIDROME_PORT=20070
CALIBREWEB_PORT=20078
KOMGA_PORT=20077

# Cloud
FORGEJO_PORT=20110
FORGEJO_SSH_PORT=20111
IMMICH_PORT=2283
VAULTWARDEN_PORT=20315
NEXTCLOUD_PORT=20460

# Services
PAPERLESS_PORT=20301
HOME_ASSISTANT_PORT=20340
ACTUAL_BUDGET_PORT=20350
MEALIE_PORT=20360
JOPLIN_PORT=20370
STIRLING_PDF_PORT=20380
MONICA_PORT=20390
DRAWIO_PORT=20401
EXCALIDRAW_PORT=20402
IT_TOOLS_PORT=20403

# SABnzbd — uncomment when a usenet provider is subscribed
# SABNZBD_PORT=20300
# SABNZBD_API_KEY=
