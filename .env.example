# Root .env.example, copy to .env and fill in your values
# One odd thing is no ports are standard just for security sake, this may actually mess things up more than it helps though really

# Core
TZ=Europe/London
PUID=1000
PGID=1000
# Servers as default user and admin accounts. I would standardise a password but that's bad practice tbh.
DEFAULT_ADMIN=your-default-admin
# For picky systems that don't like - or _ because they're frankly stupid (looking at you navidrome)
SECOND_USER=second-user


# Defaults can be different but these are good and most likely
# Assumes you git clone homelab-config/ in your ~/ location
HOMELAB_CONFIG_ROOT=/home/${DEFAULT_ADMIN}/homelab-config
DATA_ROOT=${HOMELAB_CONFIG_ROOT}/data

# For Immich or photo service
UPLOAD_LOCATION=${DATA_ROOT}/photos

# Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=changeme-token
CLOUDFLARED_PORT=20280

# Central host/domain overrides (optional)
DOMAIN=example-domain.com
#static Tailscale IP (use MagicDNS where possible instead)
TAILSCALE_IP=changeme-100.xxx.xx.x

# VPN, toggleable
USE_VPN=false
# Personally I have ProtonVPN so go to:
# account.proton.me -> VPN -> OpenVPN config
OPENVPN_USER=${DEFAULT_ADMIN}
OPENVPN_PASSWORD=changeme_password
# P2P-capable countries
PROTONVPN_SERVER_COUNTRIES=Switzerland,Netherlands,Belgium,Denmark

# Authelia
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# QBITTORRENT
QBITTORRENT_WEBUI_PORT=20050
QBITTORRENT_TCP_PORT=20051
QBITTORRENT_UDP_PORT=20052
QBITTORRENT_WEBUI_USER=${DEFAULT_ADMIN}
QBITTORRENT_WEBUI_PASS=changeme_password

# Immich
DB_USERNAME=${DEFAULT_ADMIN}
DB_PASSWORD=changeme_password
DB_DATABASE_NAME=immich

# Nextcloud
NEXTCLOUD_ADMIN_USER=${DEFAULT_ADMIN}
NEXTCLOUD_ADMIN_PASSWORD=changeme_password
NEXTCLOUD_DB_PASSWORD=changeme_password
NEXTCLOUD_REDIS_PASSWORD=
NEXTCLOUD_TRUSTED_DOMAINS=nextcloud.${DOMAIN} 100.106.40.5
OVERWRITEPROTOCOL=https
OVERWRITEHOST=nextcloud.${DOMAIN}
OVERWRITECLIURL=https://nextcloud.${DOMAIN}

# Forgejo
# Double-underscore env vars map to app.ini sections: FORGEJO__<Section>__<Key>
FORGEJO__server__ROOT_URL=https://forgejo.${DOMAIN}
FORGEJO__server__SSH_DOMAIN=forgejo.${DOMAIN}
FORGEJO__server__DOMAIN=forgejo
FORGEJO__server__HTTP_PORT=3000
FORGEJO__server__OFFLINE_MODE=false

# Vaultwarden aka bitwarden open source server
VAULTWARDEN_SIGNUPS_ALLOWED=false
# Admin panel token: must be Argon2 hash NOT the plain password.
# Generate: docker run --rm -it vaultwarden/server /vaultwarden hash --preset owasp
# Leave blank to disable the admin panel entirely (recommended for solo use).
VAULTWARDEN_ADMIN_TOKEN=changeme_token

# ─── Paperless-ngx ────────────────────────────────────────────────────────────
# auto-generated
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_USER=${DEFAULT_ADMIN}
PAPERLESS_ADMIN_MAIL=admin@${DOMAIN}
PAPERLESS_ADMIN_PASSWORD=your_paperless_admin_password
PAPERLESS_DB_PASSWORD=                      # auto-generated
PAPERLESS_URL=https://paperless.${DOMAIN}

# ─── Joplin ───────────────────────────────────────────────────────────────────
JOPLIN_DB_PASSWORD=                         # auto-generated
JOPLIN_BASE_URL=https://joplin.${DOMAIN}

# ─── Mealie ───────────────────────────────────────────────────────────────────
MEALIE_DEFAULT_EMAIL=admin@${DOMAIN}
MEALIE_DEFAULT_PASSWORD=your_mealie_admin_password
MEALIE_BASE_URL=https://mealie.${DOMAIN}

# ─── Monica ───────────────────────────────────────────────────────────────────
# ⚠ Must have the base64: prefix — auto-generated by generate-secrets.sh
# Manual generation: echo "base64:$(openssl rand -base64 32)"
MONICA_APP_KEY=

# ─── Yamtrack ─────────────────────────────────────────────────────────────────
YAMTRACK_SECRET=                            # auto-generated
YAMTRACK_EXTERNAL_URL=https://yamtrack.${DOMAIN}
YAMTRACK_REGISTRATION=False
# TMDB v3 API key (optional) — https://www.themoviedb.org/settings/api → API Key (v3 auth)
YAMTRACK_TMDB_API=
# Trakt OAuth — register at https://trakt.tv/oauth/applications
# Redirect URI: https://yamtrack.${DOMAIN}/import/trakt/private
YAMTRACK_TRAKT_CLIENT_ID=
YAMTRACK_TRAKT_CLIENT_SECRET=
# AniList OAuth — register at https://anilist.co/settings/developer
# Redirect URI: https://yamtrack.${DOMAIN}/import/anilist/private
YAMTRACK_ANILIST_CLIENT_ID=
YAMTRACK_ANILIST_CLIENT_SECRET=
# Simkl OAuth — register at https://simkl.com/settings/developer
# Redirect URI: https://yamtrack.${DOMAIN}/import/simkl/private
YAMTRACK_SIMKL_CLIENT_ID=
YAMTRACK_SIMKL_CLIENT_SECRET=
# Steam API key (optional) — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# ─── Backups ──────────────────────────────────────────────────────────────────
RESTIC_BACKUP_PASSWORD=                     # auto-generated
RESTIC_S3_KEY_ID=your_backblaze_b2_key_id
RESTIC_S3_SECRET=your_backblaze_b2_application_key

# ─── Uptime Kuma ──────────────────────────────────────────────────────────────
# Set AFTER running Uptime Kuma for the first time (the UI wizard creates the account).
# Re-run setup-uptime-kuma.sh once these are populated.
UPTIMEKUMA_USER=${DEFAULT_ADMIN}
UPTIMEKUMA_PASS=

# ─── API keys (fill in after each service starts) ─────────────────────────────
# Found in each service's web UI: Settings → General (or Dashboard → API Keys for Jellyfin)
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
LIDARR_API_KEY=
BAZARR_API_KEY=
JELLYFIN_API_KEY=
SEERR_API_KEY=
ABS_API_KEY=

