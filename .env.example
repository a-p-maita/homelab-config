# Root .env.example for all stacks
# Core
CLOUDFLARED_PORT=20280
TUNNEL_TOKEN=put_your_cloudflare_token_here
# Media
PUID=1000
PGID=1000
ABS_PORT=20020
# Yamtrack (media tracker)
YAMTRACK_PORT=20041
CROSSWATCH_PORT=20042
QBITTORRENT_WEBUI_PORT=20050
QBITTORRENT_TCP_PORT=20051
QBITTORRENT_UDP_PORT=20052
QBITTORRENT_WEBUI_USER=your_qbt_username
QBITTORRENT_WEBUI_PASS=your_qbt_webui_password
ABB_PORT=20060
JACKETT_PORT=20065
JACKETT_API_KEY=your_jackett_api_key
# Yamtrack secrets — generate SECRET with: python3 -c "import secrets; print(secrets.token_hex(32))"
YAMTRACK_SECRET=your_yamtrack_secret_key
YAMTRACK_EXTERNAL_URL=https://yamtrack.your-domain.com
# TMDB v3 API key (optional — Yamtrack has a built-in default)
YAMTRACK_TMDB_API=
# Trakt client ID for Yamtrack import feature
YAMTRACK_TRAKT_CLIENT_ID=your_trakt_client_id
# Productivity
FORGEJO_WEB_PORT=20110
FORGEJO_SSH_PORT=20111
FORGEJO__server__ROOT_URL=https://your-domain.com
FORGEJO__server__HTTP_ADDR=0.0.0.0
FORGEJO__server__HTTP_PORT=3000
FORGEJO__server__SSH_DOMAIN=your-domain.com
FORGEJO__server__OFFLINE_MODE=false
# Music
NAVIDROME_PORT=20070
FEISHIN_PORT=20072
LIDARR_PORT=20073
SLSKD_PORT=20075
SLSKD_P2P_PORT=50300
SLSKD_USERNAME=your_slskd_username
SLSKD_PASSWORD='your_slskd_password'
# Set to your Cloudflare tunnel URL for Navidrome (Feishin browser client connects here)
NAVIDROME_EXTERNAL_URL=https://navidrome.your-domain.com
# Octo-Fiesta (Subsonic API proxy — intercepts playback to stream hi-res from providers)
OCTOFIESTA_PORT=20076
OCTOFIESTA_EXTERNAL_URL=https://octo-fiesta.your-domain.com
# Provider: SquidWTF (free, no creds), Deezer, Qobuz, or Yandex
OCTOFIESTA_MUSIC_SERVICE=SquidWTF
# SquidWTF settings (Qobuz or Tidal backend, no account required)
OCTOFIESTA_SQUIDWTF_SOURCE=Qobuz
OCTOFIESTA_SQUIDWTF_QUALITY=
# Deezer settings (leave blank if not using Deezer)
OCTOFIESTA_DEEZER_ARL=
OCTOFIESTA_DEEZER_ARL_FALLBACK=
OCTOFIESTA_DEEZER_QUALITY=
# Qobuz settings (leave blank if not using Qobuz)
OCTOFIESTA_QOBUZ_USER_AUTH_TOKEN=
OCTOFIESTA_QOBUZ_USER_ID=
OCTOFIESTA_QOBUZ_QUALITY=
# Yandex Music settings (leave blank if not using Yandex)
OCTOFIESTA_YANDEX_OAUTH_TOKEN=
OCTOFIESTA_YANDEX_QUALITY=
# Monitoring
HOMEPAGE_PORT=20200
UPTIMEKUMA_PORT=20201
# Comma-separated host:port pairs allowed to access Homepage (prevents host validation errors)
HOMEPAGE_ALLOWED_HOSTS=your-tailscale-ip:20200,localhost:3000
# Immich
UPLOAD_LOCATION=./homelab-data/immich_upload
DB_DATA_LOCATION=./homelab-data/immich_db
IMMICH_VERSION=release
DB_PASSWORD='your_db_password'
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# ─── Documents stack (paperless-ngx, paperless-gpt, stirling-pdf, kiwix) ─────
PAPERLESS_PORT=20301
PAPERLESS_GPT_PORT=20302
STIRLING_PDF_PORT=20303
KIWIX_PORT=20304

PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_EMAIL=admin@example.com
PAPERLESS_ADMIN_PASS=your_paperless_admin_password
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASS=your_paperless_db_password
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
PAPERLESS_SECRET_KEY=your_64char_random_secret_key
PAPERLESS_EXTERNAL_URL=https://paperless.your-domain.com
# After first paperless start: Admin > Auth Tokens > Add Token — paste here and restart
PAPERLESS_GPT_API_TOKEN=your_paperless_api_token
# LLM provider for paperless-gpt: ollama, openai, mistral, anthropic, googleai
PAPERLESS_GPT_LLM_PROVIDER=ollama
PAPERLESS_GPT_LLM_MODEL=qwen3:8b
# For Ollama on the host: http://host.docker.internal:11434
PAPERLESS_GPT_OLLAMA_HOST=http://host.docker.internal:11434

# ─── Tools stack (code-server, draw.io, excalidraw, IT-Tools, libreoffice,
#      vaultwarden, actual-budget, joplin, meshcentral) ──────────────────────────
CODE_SERVER_PORT=20310
DRAWIO_PORT=20311
EXCALIDRAW_PORT=20312
IT_TOOLS_PORT=20313
LIBREOFFICE_PORT=20314
VAULTWARDEN_PORT=20315
ACTUAL_BUDGET_PORT=20316
JOPLIN_PORT=20317
MESHCENTRAL_PORT=20319
MESHCENTRAL_HTTP_PORT=20320

CODE_SERVER_PASSWORD=your_code_server_password
CODE_SERVER_SUDO_PASSWORD=your_code_server_sudo_password
# Generate admin token hash: docker run --rm -it vaultwarden/server /vaultwarden hash --preset owasp
VAULTWARDEN_ADMIN_TOKEN=your_argon2_hashed_admin_password
VAULTWARDEN_EXTERNAL_URL=https://vault.your-domain.com
JOPLIN_EXTERNAL_URL=https://joplin.your-domain.com
JOPLIN_DB_USER=joplin
JOPLIN_DB_PASS=your_joplin_db_password

# ─── Personal stack (mealie, lubelogger, monica, worldmonitor) ────────────────
MEALIE_PORT=20321
LUBELOGGER_PORT=20322
MONICA_PORT=20323
WORLDMONITOR_PORT=20324

MEALIE_EXTERNAL_URL=https://mealie.your-domain.com
# Mealie default admin: changeme@example.com / MyPassword — change on first login
LUBELOGGER_ADMIN_USER=admin
LUBELOGGER_ADMIN_PASS=your_lubelogger_password
# Monica APP_KEY: echo "base64:$(openssl rand -base64 32)"
MONICA_APP_KEY=base64:your_base64_encoded_32byte_key
MONICA_EXTERNAL_URL=https://monica.your-domain.com
MONICA_DB_USER=monica
MONICA_DB_PASS=your_monica_db_password
MONICA_DB_ROOT_PASS=your_monica_db_root_password

# ─── Entertainment stack (jellyfin, romm) ─────────────────────────────────────
JELLYFIN_PORT=20330
ROMM_PORT=20331

# ROMM IGDB API: register app at https://dev.twitch.tv → Applications → New App
ROMM_IGDB_CLIENT_ID=your_igdb_client_id
ROMM_IGDB_CLIENT_SECRET=your_igdb_client_secret
# Generate with: openssl rand -hex 32
ROMM_SECRET_KEY=your_romm_secret_key
ROMM_ADMIN_USER=admin
ROMM_ADMIN_PASS=your_romm_admin_password
ROMM_DB_USER=romm
ROMM_DB_PASS=your_romm_db_password
ROMM_DB_ROOT_PASS=your_romm_db_root_password

# ─── Home stack (home-assistant) ──────────────────────────────────────────────
HOME_ASSISTANT_PORT=20340

# ─── Commented-out / stopped services (uncomment if enabling) ─────────────────
# Nginx Proxy Manager (redundant with Cloudflared — only if needed for local routing)
# NPM_HTTP_PORT=20350
# NPM_HTTPS_PORT=20351
# NPM_ADMIN_PORT=20352
# Authelia (needs full YAML config file first — see docs.authelia.com)
# AUTHELIA_PORT=20353
# AUTHELIA_JWT_SECRET=your_authelia_jwt_secret
# AUTHELIA_SESSION_SECRET=your_authelia_session_secret
# AUTHELIA_STORAGE_ENCRYPTION_KEY=your_authelia_storage_key
# Authentik (needs postgres + redis + worker — see docs.goauthentik.io)
# AUTHENTIK_HTTP_PORT=20354
# AUTHENTIK_HTTPS_PORT=20355
# AUTHENTIK_DB_PASS=your_authentik_db_password
# AUTHENTIK_SECRET_KEY=your_authentik_secret_key_openssl_rand_hex_32
# PeerTube (needs SMTP configuration — see docs.joinpeertube.org)
# PEERTUBE_PORT=20360
# PEERTUBE_DB_USER=peertube
# PEERTUBE_DB_PASS=your_peertube_db_password
# PEERTUBE_EXTERNAL_HOSTNAME=peertube.your-domain.com
# PEERTUBE_SMTP_HOST=smtp.example.com
# PEERTUBE_SMTP_PORT=587
# PEERTUBE_SMTP_USER=your_smtp_username
# PEERTUBE_SMTP_PASS=your_smtp_password
# PEERTUBE_SMTP_FROM=noreply@your-domain.com
# PEERTUBE_ADMIN_EMAIL=admin@your-domain.com
# PEERTUBE_SECRET=your_peertube_secret_openssl_rand_hex_32
